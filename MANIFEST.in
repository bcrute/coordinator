include CHANGELOG.md
include LICENSE
include README.md
include pyproject.toml
recursive-include src/coordinator *.py *.md *.html *.css *.js *.yaml
prune .coordination
prune .github
prune build
prune deploy
prune docs
prune examples
prune *_demo
prune skills
prune tests
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude *.zip
exclude workflow.toml
